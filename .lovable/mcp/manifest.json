            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Numero massimo di risultati (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_provvigioni",
        "title": "Provvigioni e scadenziario",
