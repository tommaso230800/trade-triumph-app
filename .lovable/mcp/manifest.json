    "tools": [
      {
        "name": "list_clienti",
        "title": "Elenco clienti",
        "description": "Cerca i clienti del CRM per nome, città o consorzio. Restituisce fatturato, numero ordini e contatti.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Testo da cercare nel nome del cliente."
            },
            "citta": {
              "type": "string",
              "description": "Filtra per città."
            },
            "consorzio": {
              "type": "string",
              "description": "Filtra per consorzio (es. ADAT, CBF)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Numero massimo di risultati (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_cliente",
        "title": "Scheda cliente",
        "description": "Restituisce la scheda completa di un cliente: anagrafica, fatturato, ultimi ordini e note commerciali.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del cliente."
            }
          },
          "required": [
            "cliente_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_ordini",
        "title": "Elenco ordini",
        "description": "Elenca gli ordini del CRM con filtri per stato, cliente, azienda e periodo. Include totale, provvigione prevista e stato provvigione.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stato": {
              "type": "string",
              "enum": [
                "in_attesa",
                "spedito",
                "completato",
                "annullato",
                "stand_by"
              ],
              "description": "Filtra per stato dell'ordine."
            },
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del cliente."
            },
            "azienda_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID dell'azienda."
            },
            "da_data": {
              "type": "string",
              "description": "Data ordine minima, formato AAAA-MM-GG."
            },
            "a_data": {
              "type": "string",
              "description": "Data ordine massima, formato AAAA-MM-GG."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Numero massimo di risultati (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_ordine",
        "title": "Dettaglio ordine",
        "description": "Restituisce un singolo ordine con tutte le righe: prodotto, quantità in cartoni e pezzi, prezzo, sconti a cascata e omaggi.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
