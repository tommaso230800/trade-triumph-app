            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Numero massimo di risultati (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_nota",
        "title": "Crea nota commerciale",
        "description": "Crea una nota commerciale nel CRM, opzionalmente collegata a un cliente o a un'azienda.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "titolo": {
              "type": "string",
              "minLength": 1,
              "description": "Titolo della nota."
            },
            "contenuto": {
              "type": "string",
              "description": "Testo della nota."
            },
            "categoria": {
              "type": "string",
              "description": "Categoria della nota (default: generale)."
            },
            "priorita": {
              "type": "string",
              "enum": [
                "alta",
                "media",
                "bassa"
              ],
              "description": "Priorità (default: media)."
