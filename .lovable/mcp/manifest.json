            "trimestre_pagamento": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Trimestre di pagamento 1-4."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Numero massimo di risultati (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_canvass_promo",
        "title": "Canvass e promozioni",
        "description": "Elenca i canvass e le promozioni caricati nel CRM, con periodo di validità, sconti e prodotti coinvolti.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "azienda_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID dell'azienda."
