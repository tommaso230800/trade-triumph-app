            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID del cliente collegato."
            },
            "azienda_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID dell'azienda collegata."
            },
            "data_promemoria": {
              "type": "string",
              "description": "Data promemoria, formato AAAA-MM-GG."
            }
          },
          "required": [
            "titolo"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
